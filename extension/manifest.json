{
  "manifest_version": 3,
  "name": "Vocabify Capture",
  "version": "1.0.0",
  "description": "Save vocabulary to your Vocabify lists.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vocabify Capture"
  },
  "permissions": ["storage", "alarms", "activeTab", "scripting"],
  "host_permissions": ["https://api.datamuse.com/*", "https://api.dictionaryapi.dev/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
