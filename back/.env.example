# Copy to .env and fill in values for production.
# ASP.NET Core maps these to config using __ as the hierarchy separator.

ConnectionStrings__Postgres=Host=<host>;Port=5432;Database=vocabify;Username=<user>;Password=<password>
ConnectionStrings__Redis=<host>:6379

Jwt__Secret=<random-secret-at-least-32-characters>

App__PublicUrl=https://<your-domain>

OAuth__Google__ClientId=
OAuth__Google__ClientSecret=
OAuth__GitHub__ClientId=
OAuth__GitHub__ClientSecret=

Smtp__Host=<smtp-host>
Smtp__Port=587
Smtp__From=noreply@<your-domain>
